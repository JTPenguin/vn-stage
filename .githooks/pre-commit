#!/bin/sh
# Runs the module's checks before a commit and refuses the commit on a failure.
# Staged scripts/, tools/, lang/ or module.json: tools/test.mjs and tools/check-load.mjs (both must pass).
# Staged items/: the items checker. It checks the working tree, so unstaged edits count too.
# Skip once with: git commit --no-verify
cd "$(git rev-parse --show-toplevel)" || exit 1
staged=$(git diff --cached --name-only)
fail=0
if printf '%s\n' "$staged" | grep -Eq '^(scripts/|tools/|lang/|module\.json$)'; then
    for t in test check-load; do
        if ! out=$(ELECTRON_RUN_AS_NODE=1 "$HOME/foundryvtt/foundryvtt" "tools/$t.mjs" 2>&1); then
            printf '%s\n' "$out" | tail -25
            echo "pre-commit: tools/$t.mjs failed"
            fail=1
        else
            echo "pre-commit: tools/$t.mjs passed"
        fi
    done
fi
if printf '%s\n' "$staged" | grep -q '^items/'; then
    if ! out=$(python3 "/home/justin/Projects/Character Art Pipeline/infra/items.py" --dir=items check 2>&1); then
        printf '%s\n' "$out" | head -25
        echo "pre-commit: the items check failed"
        fail=1
    else
        echo "pre-commit: items $out"
    fi
fi
if [ "$fail" -ne 0 ]; then
    echo "pre-commit: the commit was refused (git commit --no-verify to skip)"
    exit 1
fi
