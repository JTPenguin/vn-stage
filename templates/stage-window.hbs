<div class="vn-stage-body">
  {{#unless stage}}
  <section class="vn-section">
    <p>{{#if sceneName}}<strong>{{sceneName}}</strong> isn't a stage yet.{{else}}No scene is being viewed.{{/if}}</p>
    {{#if sceneName}}<button type="button" data-action="makeStage"><i class="fa-solid fa-masks-theater"></i> Make stage</button>{{/if}}
  </section>
  {{else}}

  <div class="vn-tabrow">
    <nav class="tabs vn-tabs" data-group="main" aria-label="Stage window tabs">
      <a data-action="tab" data-group="main" data-tab="cast" class="{{tabs.cast.cssClass}}">Cast</a>
      <a data-action="tab" data-group="main" data-tab="background" class="{{tabs.background.cssClass}}">Background</a>
      <a data-action="tab" data-group="main" data-tab="presets" class="{{tabs.presets.cssClass}}">Presets</a>
    </nav>
    <span class="vn-tagbar">
      <i class="fa-solid fa-tag" data-tooltip="Tag: sets the Presets, the Background strip and the Cast list"></i>
      <select name="tag" aria-label="Tag">
        <option value="" {{#if allSelected}}selected{{/if}}>All characters</option>
        <option value="__recent" {{#if recentSelected}}selected{{/if}}>Recent</option>
        <option value="__untagged" {{#if untaggedSelected}}selected{{/if}}>Untagged</option>
        {{#if tags.length}}
        <optgroup label="Tags">
          {{#each tags}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
        </optgroup>
        {{/if}}
      </select>
      <button type="button" class="vn-icon" data-action="manageTags" data-tooltip="Manage tags: rename, merge, delete, folders"><i class="fa-solid fa-gear"></i></button>
    </span>
  </div>

  <section class="vn-section vn-presets tab {{tabs.presets.cssClass}}" data-group="main" data-tab="presets">
    <div class="vn-tab-actions">
      <button type="button" data-action="savePreset" data-tooltip="Save what's on stage as a new preset{{#if tag}} tagged {{tag.label}}{{/if}}"><i class="fa-solid fa-plus"></i> Save as preset</button>
    </div>
    <ul class="vn-preset-list">
      {{#each presets}}
      <li data-preset="{{id}}" data-name="{{name}}">
        <button type="button" class="vn-preset-row {{#if current}}current{{/if}}" data-action="loadPreset" aria-label="Load {{name}}">
          <span class="vn-preset-thumb">
            {{#if background}}{{#if background.video}}<video src="{{background.src}}" muted loop playsinline preload="metadata"></video><i class="fa-solid fa-film vn-bg-video"></i>{{else}}<img src="{{background.src}}" alt="" loading="lazy">{{/if}}
            {{else}}<i class="fa-regular fa-image vn-preset-nobg" data-tooltip="No background saved"></i>{{/if}}
          </span>
          <span class="vn-preset-body">
            <span class="vn-preset-name"><span class="vn-name">{{name}}</span>{{#if changed}}<span class="vn-changed" data-tooltip="The stage has changed since it was loaded"></span>{{/if}}</span>
            <span class="vn-preset-faces">
              {{#if party}}<span class="vn-face vn-face-party" data-name="{{party.label}}" data-tooltip="{{party.label}}"><i class="fa-solid fa-users"></i></span>{{/if}}
              {{#each faces}}<span class="vn-face" data-name="{{name}}" data-tooltip="{{tooltip}}">{{#if thumb}}<img src="{{thumb}}" alt="" loading="lazy">{{else}}<i class="fa-solid fa-user"></i>{{/if}}</span>{{/each}}
              <span class="vn-face vn-face-more" hidden></span>
            </span>
          </span>
        </button>
      </li>
      {{else}}
      <li class="vn-empty">{{emptyPresets}}</li>
      {{/each}}
    </ul>
  </section>

  <section class="vn-section vn-background tab {{tabs.background.cssClass}}" data-group="main" data-tab="background">
    <div class="vn-tab-actions vn-bg-row">
      {{#unless bg.tagged}}{{#if bg.folder}}<span class="vn-bg-folder">{{bg.folder}}</span>{{/if}}{{/unless}}
      <button type="button" data-action="browseBackground" data-tooltip="Show a background without tagging it"><i class="fa-solid fa-folder-open"></i> Browse…</button>
    </div>

    <div class="vn-bg-scroll">
      {{#if bg.headed}}
      {{#if bg.pinned.length}}<div class="vn-bg-strip">{{#each bg.pinned}}{{> "vn-stage.bg"}}{{/each}}</div>{{/if}}
      {{#unless bg.singles}}<button type="button" class="vn-bg-add-line" data-action="addBackgroundToTag" data-tooltip="{{addBackgroundLabel}}"><i class="fa-solid fa-plus"></i> Add a background</button>{{/unless}}
      {{#each bg.strips}}
      <div class="vn-bg-folder-group {{#if collapsed}}collapsed{{/if}}" data-folder="{{folder}}">
        <h4 data-action="toggleFolder"><i class="fa-solid fa-chevron-down vn-chevron"></i> {{heading}}{{#if singles}}<button type="button" class="vn-bg-add-line" data-action="addBackgroundToTag" data-tooltip="{{@root.addBackgroundLabel}}"><i class="fa-solid fa-plus"></i> Add a background</button>{{else}}<button type="button" class="vn-bg-add-line" data-action="removeFolderFromTag" data-tooltip="Take this folder off {{@root.tag.label}}" aria-label="Take this folder off {{@root.tag.label}}"><i class="fa-solid fa-xmark"></i></button>{{/if}}</h4>
        <div class="vn-bg-strip">{{#each choices}}{{> "vn-stage.bg"}}{{else}}<p class="vn-empty">No images</p>{{/each}}</div>
      </div>
      {{/each}}
      {{else}}
      <div class="vn-bg-strip">
        {{#each bg.pinned}}{{> "vn-stage.bg"}}{{/each}}
        {{#each bg.strips}}{{#each choices}}{{> "vn-stage.bg"}}{{/each}}{{/each}}
      </div>
      {{/if}}
      {{#if bg.tagged}}<button type="button" class="vn-bg-add-line" data-action="addFolderToTag" data-tooltip="Add a folder of backgrounds to {{tag.label}}"><i class="fa-solid fa-folder-plus"></i> Add folder…</button>
      {{else}}{{#unless bg.folder}}<p class="vn-empty">Browse to a scenario's scene art to swap between its images here.</p>{{/unless}}{{/if}}
    </div>
  </section>

  <section class="vn-section vn-cast tab {{tabs.cast.cssClass}}" data-group="main" data-tab="cast">
    <div class="vn-tab-actions vn-cast-tools">
      <input type="search" name="filter" value="{{filter}}" placeholder="{{#if allSelected}}Search{{else}}Search (finds everyone){{/if}}" autocomplete="off">
      <button type="button" class="vn-icon" data-action="resetExpressions" data-tooltip="Reset everyone's expression to neutral, on every stage"><i class="fa-solid fa-face-meh"></i></button>
      <button type="button" class="vn-icon" data-action="refreshCast" data-tooltip="Re-read the art folder"><i class="fa-solid fa-rotate"></i></button>
      <button type="button" class="vn-icon vn-clear-stage" data-action="clearStage" data-tooltip="Clear the stage: take everyone off (asks first)" aria-label="Clear the stage" {{#unless anyoneOnStage}}disabled{{/unless}}><i class="fa-solid fa-broom"></i></button>
    </div>
    <ul class="vn-cast-list">
      {{#if party}}
      <li class="vn-tile vn-cast-party {{#if party.together}}on-stage{{else if party.onStage}}partly-on-stage{{/if}}" data-search="the party" data-party draggable="true" data-tooltip="{{party.label}}: every party member at once. Drag onto the stage to gather them where you drop them; × takes them all off.">
        <span class="vn-tile-art vn-party-icon"><i class="fa-solid fa-users"></i>
          {{#if party.onStage}}<button type="button" class="vn-row-remove" data-action="removeParty" aria-label="Take the party off the stage" data-tooltip="Take every party member off the stage"><i class="fa-solid fa-xmark"></i></button>{{/if}}
        </span>
        <span class="vn-name">{{party.label}}</span>
      </li>
      {{/if}}
      {{#each cast}}{{> "vn-stage.cast-row"}}{{else}}
      <li class="vn-empty">{{emptyCast}}</li>
      {{/each}}
      {{#if others.length}}
      <li class="vn-cast-divider" hidden>{{outsideLabel}}</li>
      {{#each others}}{{> "vn-stage.cast-row" outside=true}}{{/each}}
      {{/if}}
    </ul>
  </section>
  {{/unless}}
</div>
