<div class="vn-stage-body">
  {{#unless stage}}
  <section class="vn-section">
    <p>{{#if sceneName}}<strong>{{sceneName}}</strong> isn't a stage yet.{{else}}No scene is being viewed.{{/if}}</p>
    {{#if sceneName}}<button type="button" data-action="makeStage"><i class="fa-solid fa-masks-theater"></i> Make stage</button>{{/if}}
  </section>
  {{else}}

  <section class="vn-groupbar">
    <i class="fa-solid fa-layer-group" data-tooltip="Group: sets the Presets, the Background strip and the Cast list"></i>
    <select name="group" aria-label="Group">
      <option value="" {{#if allSelected}}selected{{/if}}>All characters</option>
      <option value="__recent" {{#if recentSelected}}selected{{/if}}>Recent</option>
      {{#if groups.length}}
      <optgroup label="Groups">
        {{#each groups}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
      </optgroup>
      {{/if}}
    </select>
    <button type="button" class="vn-icon" data-action="manageGroups" data-tooltip="Manage groups"><i class="fa-solid fa-gear"></i></button>
  </section>

  <section class="vn-section vn-presets {{#if collapsed.presets}}collapsed{{/if}}" data-section="presets">
    <h3 data-action="toggleSection"><i class="fa-solid fa-chevron-down vn-chevron"></i> Presets
      {{#if changedPreset}}<button type="button" class="vn-preset-update" data-action="updatePreset" data-preset="{{changedPreset.id}}" data-tooltip="Update {{changedPreset.name}}: save what's on stage now over it"><i class="fa-solid fa-floppy-disk"></i> Update</button>{{/if}}
      <button type="button" class="vn-icon {{#unless changedPreset}}vn-push{{/unless}}" data-action="savePreset" data-tooltip="Save stage as preset{{#if group}} in {{group.label}}{{/if}}"><i class="fa-solid fa-plus"></i></button>
    </h3>
    <ul class="vn-preset-list">
      {{#each presets}}
      <li data-preset="{{id}}" data-name="{{name}}">
        <button type="button" class="vn-preset-chip {{#if current}}current{{/if}}" data-action="loadPreset" data-tooltip="{{tooltip}}">
          <i class="fa-solid fa-play"></i><span class="vn-name">{{name}}</span>{{#if changed}}<span class="vn-changed"></span>{{/if}}
        </button>
      </li>
      {{else}}
      <li class="vn-empty">No presets{{#if group}} in this group{{/if}} yet. Save the stage with +.</li>
      {{/each}}
    </ul>
  </section>

  <section class="vn-section vn-background {{#if collapsed.background}}collapsed{{/if}}" data-section="background">
    <h3 data-action="toggleSection"><i class="fa-solid fa-chevron-down vn-chevron"></i> Background</h3>

    <div class="vn-bg-scroll">
      {{#if bg.strips.[0].showHeading}}
      <div class="vn-bg-strip">{{#each bg.pinned}}{{> "vn-stage.bg"}}{{/each}}</div>
      {{#each bg.strips}}
      <div class="vn-bg-folder-group {{#if collapsed}}collapsed{{/if}}" data-folder="{{folder}}">
        <h4 data-action="toggleFolder"><i class="fa-solid fa-chevron-down vn-chevron"></i> {{heading}}</h4>
        <div class="vn-bg-strip">{{#each choices}}{{> "vn-stage.bg"}}{{else}}<p class="vn-empty">No images</p>{{/each}}</div>
      </div>
      {{/each}}
      {{else}}
      <div class="vn-bg-strip">
        {{#each bg.pinned}}{{> "vn-stage.bg"}}{{/each}}
        {{#each bg.strips}}{{#each choices}}{{> "vn-stage.bg"}}{{/each}}{{/each}}
      </div>
      {{/if}}
    </div>

    <div class="vn-bg-row">
      <button type="button" data-action="browseBackground"><i class="fa-solid fa-folder-open"></i> Browse…</button>
      <span class="vn-bg-folder">
        {{#if bg.grouped}}{{#unless bg.strips.length}}This group has no backgrounds yet. Add them in Manage groups.{{/unless}}
        {{else}}{{#if bg.folder}}{{bg.folder}}{{else}}Browse to a scenario's scene art to swap between its images here.{{/if}}{{/if}}
      </span>
    </div>
  </section>

  <section class="vn-section vn-cast {{#if collapsed.cast}}collapsed{{/if}}" data-section="cast">
    <h3 data-action="toggleSection"><i class="fa-solid fa-chevron-down vn-chevron"></i> Cast
      <button type="button" class="vn-icon" data-action="resetExpressions" data-tooltip="Reset everyone's expression to neutral, on every stage"><i class="fa-solid fa-face-meh"></i></button>
      <button type="button" class="vn-icon vn-icon-tight" data-action="refreshCast" data-tooltip="Re-read the art folder"><i class="fa-solid fa-rotate"></i></button>
    </h3>
    <div class="vn-cast-tools">
      <input type="search" name="filter" value="{{filter}}" placeholder="{{#if allSelected}}Search{{else}}Search (finds everyone){{/if}}" autocomplete="off">
    </div>
    <ul class="vn-cast-list">
      {{#if party}}
      <li class="vn-cast-party {{#if party.side}}on-stage{{/if}}" data-search="the party" data-party draggable="true">
        <span class="vn-party-icon"><i class="fa-solid fa-users"></i></span>
        <span class="vn-name">{{party.label}}</span>
        <span class="vn-toggles">
          <button type="button" class="vn-toggle {{#if (eq party.side 'left')}}active{{/if}}" data-action="addParty" data-side="left" aria-pressed="{{eq party.side 'left'}}">Left</button>
          <button type="button" class="vn-toggle {{#if (eq party.side 'right')}}active{{/if}}" data-action="addParty" data-side="right" aria-pressed="{{eq party.side 'right'}}">Right</button>
        </span>
      </li>
      {{/if}}
      {{#each cast}}{{> "vn-stage.cast-row"}}{{else}}
      <li class="vn-empty">{{emptyCast}}</li>
      {{/each}}
      {{#if others.length}}
      <li class="vn-cast-divider" hidden>Not in this group</li>
      {{#each others}}{{> "vn-stage.cast-row" outside=true}}{{/each}}
      {{/if}}
    </ul>
  </section>
  {{/unless}}
</div>
