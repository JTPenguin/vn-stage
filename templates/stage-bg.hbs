<button type="button" class="vn-bg-choice {{#if current}}current{{/if}} {{#if pinned}}pinned{{/if}} {{#if elsewhere}}elsewhere{{/if}}" data-action="setBackground" data-src="{{src}}" {{#if tagItem}}data-tag-item="{{tagItem}}"{{/if}} aria-label="{{label}}">
  {{#if video}}
  <video src="{{src}}" muted loop playsinline preload="metadata"></video>
  <i class="fa-solid fa-film vn-bg-video"></i>
  {{else}}
  <img src="{{src}}" alt="" loading="lazy">
  {{/if}}
  {{#if pinned}}<i class="fa-solid fa-house vn-bg-pin"></i>{{/if}}
  <span class="vn-bg-name">{{label}}</span>
</button>
