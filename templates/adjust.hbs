<div class="vn-adjust-body">
  <p class="hint">The blue guide lines show where faces should start and end, following the character's size. Line the face up with them. Changes are relative to the art's own scale and height, and apply on every stage. Reset goes back to the art's own.</p>
  <div class="form-group">
    <label>Size</label>
    <select name="size">
      <option value="">{{autoLabel}}</option>
      {{#each sizes}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
    </select>
  </div>
  <div class="form-group">
    <label>Scale</label>
    <div class="vn-slider">
      <input type="range" name="scale" min="0.25" max="3" step="0.01" value="{{scale}}">
      <input type="number" name="scale" min="0.1" max="5" step="0.01" value="{{scale}}">
    </div>
  </div>
  <div class="form-group">
    <label>Lower by (% of height)</label>
    <div class="vn-slider">
      <input type="range" name="yOffset" min="-60" max="100" step="0.5" value="{{yOffset}}">
      <input type="number" name="yOffset" min="-100" max="150" step="0.5" value="{{yOffset}}">
    </div>
  </div>
  <footer class="vn-adjust-buttons">
    <button type="button" data-action="reset"><i class="fa-solid fa-rotate-left"></i> Reset</button>
    <button type="button" data-action="done"><i class="fa-solid fa-check"></i> Done</button>
  </footer>
</div>
